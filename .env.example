# Any keys you leave empty fall back to the next provider, then to simulated mode.
GEMINI_API_KEY=        # fast model: map updates + alert check
ANTHROPIC_API_KEY=     # recaps: Catch me up / What did I miss
DEEPGRAM_API_KEY=      # live microphone with speaker labels (optional; Chrome speech is the fallback)
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5-5
